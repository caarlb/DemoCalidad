{
  "name": "democalidad",
  "version": "1.0.0",
  "description": "Cotizador generico de practica para demostrar CI/CD con Azure DevOps",
  "main": "src/app.js",
  "scripts": {
    "start": "node bin/www",
    "test": "jest --ci",
    "test:local": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "results.xml"
        }
      ]
    ]
  }
}
